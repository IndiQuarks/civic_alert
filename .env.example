# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset locally to use SQLite. Set this on your VPS to use Neon.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-broad-fire-a1niym4m-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Email (Gmail App Password) ────────────────────────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-random-string-here
